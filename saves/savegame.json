            "movement_chance": 0,
            "affinity": [
              "bridge"
            ],
            "route": []
          },
          "visuals": {
            "img": "face_val_stern",
            "desc": "Ihre Hände fliegen über die Konsole, obwohl sie kaum stehen kann. Ihr Blick ist starr auf den Ereignishorizont gerichtet.",
